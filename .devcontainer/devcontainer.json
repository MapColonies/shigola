{
  "name": "shigola",
  // Order matters: the root file first makes the compose project directory the
  // repo root, which is what the relative build context and workspace mount in
  // the sibling docker-compose.yml resolve against. Reversing these, or running
  // .devcontainer/docker-compose.yml on its own, resolves them elsewhere.
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspace/shigola",
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    8080,
    5432,
    6379
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true
      }
    }
  }
}
