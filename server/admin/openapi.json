{
  "openapi": "3.0.3",
  "info": {
    "title": "Shigola — Cache Admin API",
    "description": "Purges and seeds tiles in Shigola's tile cache. Served on its own port, which must not be reachable by clients of the tile server.",
    "version": "1.0.0",
    "license": {
      "name": "MIT",
      "url": "https://github.com/MapColonies/shigola/blob/master/LICENSE.md"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "this server"
    }
  ],
  "security": [
    {
      "adminToken": []
    }
  ],
  "paths": {
    "/cache/purge": {
      "post": {
        "summary": "Purge the tiles covering an area",
        "description": "Purges the tiles covering the area at every zoom in zoomRange, from every tile matrix set each targeted map serves. The request runs to completion before the response is sent.",
        "operationId": "purge",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CacheRequest"
              },
              "examples": {
                "bounds": {
                  "summary": "By lng/lat bounds",
                  "value": {
                    "bounds": [
                      34.75,
                      32.05,
                      34.8,
                      32.1
                    ],
                    "zoomRange": {
                      "min": 10,
                      "max": 14
                    },
                    "targets": [
                      {
                        "map": "osm"
                      }
                    ]
                  }
                },
                "tiles": {
                  "summary": "By tile names, one layer only",
                  "value": {
                    "tiles": [
                      "12/2442/1659"
                    ],
                    "sourceTileMatrixSet": "WorldCRS84Quad",
                    "zoomRange": {
                      "min": 12,
                      "max": 12
                    },
                    "targets": [
                      {
                        "map": "osm",
                        "layers": [
                          "roads"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every tile was purged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CacheResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/TooLarge"
          },
          "429": {
            "$ref": "#/components/responses/Busy"
          },
          "500": {
            "$ref": "#/components/responses/Failed"
          },
          "503": {
            "$ref": "#/components/responses/TimedOut"
          }
        }
      }
    },
    "/cache/seed": {
      "post": {
        "summary": "Seed the tiles covering an area",
        "description": "Renders and caches the whole-map tiles covering the area at every zoom in zoomRange, in every tile matrix set each targeted map serves. Seeding is whole-map only. The request runs to completion before the response is sent, and renders on the pod that handles it.",
        "operationId": "seed",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedRequest"
              },
              "examples": {
                "bounds": {
                  "summary": "Re-seed an area",
                  "value": {
                    "bounds": [
                      34.75,
                      32.05,
                      34.8,
                      32.1
                    ],
                    "zoomRange": {
                      "min": 10,
                      "max": 14
                    },
                    "targets": [
                      {
                        "map": "osm"
                      }
                    ],
                    "overwrite": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every tile was seeded or skipped.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CacheResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/SeedUnprocessable"
          },
          "429": {
            "$ref": "#/components/responses/Busy"
          },
          "500": {
            "$ref": "#/components/responses/Failed"
          },
          "503": {
            "$ref": "#/components/responses/TimedOut"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document",
        "operationId": "openapi",
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI document of the Cache Admin API.",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "summary": "Swagger UI for this document",
        "operationId": "docs",
        "security": [],
        "responses": {
          "200": {
            "description": "An HTML page rendering this document.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "webserver.admin.token. Required only when one is configured."
      }
    },
    "schemas": {
      "CacheRequest": {
        "type": "object",
        "description": "Give the area as exactly one of bounds or tiles.",
        "required": [
          "zoomRange",
          "targets"
        ],
        "additionalProperties": false,
        "properties": {
          "bounds": {
            "type": "array",
            "description": "west, south, east, north in lng/lat. West greater than east crosses the antimeridian.",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "tiles": {
            "type": "array",
            "description": "z/x/y tile names in sourceTileMatrixSet. Each stands for the ground it covers.",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+/[0-9]+/[0-9]+$"
            }
          },
          "sourceTileMatrixSet": {
            "type": "string",
            "description": "The tile matrix set the tiles names belong to. Required with tiles.",
            "example": "WorldCRS84Quad"
          },
          "zoomRange": {
            "type": "object",
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "max": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "targets": {
            "type": "array",
            "description": "The maps to work on.",
            "items": {
              "$ref": "#/components/schemas/Target"
            },
            "minItems": 1
          },
          "tiers": {
            "type": "string",
            "description": "For a layered cache, tier names validated as for seed. A purge clears every tier regardless, as the CLI's purge does."
          }
        }
      },
      "SeedRequest": {
        "type": "object",
        "description": "Give the area as exactly one of bounds or tiles.",
        "required": [
          "zoomRange",
          "targets"
        ],
        "additionalProperties": false,
        "properties": {
          "bounds": {
            "type": "array",
            "description": "west, south, east, north in lng/lat. West greater than east crosses the antimeridian.",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "tiles": {
            "type": "array",
            "description": "z/x/y tile names in sourceTileMatrixSet. Each stands for the ground it covers.",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+/[0-9]+/[0-9]+$"
            }
          },
          "sourceTileMatrixSet": {
            "type": "string",
            "description": "The tile matrix set the tiles names belong to. Required with tiles.",
            "example": "WorldCRS84Quad"
          },
          "zoomRange": {
            "type": "object",
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "max": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "targets": {
            "type": "array",
            "description": "The maps to work on.",
            "items": {
              "$ref": "#/components/schemas/SeedTarget"
            },
            "minItems": 1
          },
          "overwrite": {
            "type": "boolean",
            "default": false,
            "description": "Re-render tiles that are already cached. Without it they are skipped. With a layered cache, also purges the tiers not written."
          },
          "tiers": {
            "type": "string",
            "description": "For a layered cache, the comma-separated tiers to write, or \"all\". Omitted, the last tier in read order."
          }
        }
      },
      "Target": {
        "type": "object",
        "required": [
          "map"
        ],
        "additionalProperties": false,
        "properties": {
          "map": {
            "type": "string"
          },
          "layers": {
            "type": "array",
            "description": "Narrows a purge to these layers and the map's whole-map tile, which contains them. Omitted, the whole-map tile and every layer's tile.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SeedTarget": {
        "type": "object",
        "required": [
          "map"
        ],
        "additionalProperties": false,
        "properties": {
          "map": {
            "type": "string"
          }
        }
      },
      "CacheResult": {
        "type": "object",
        "description": "Counts are per map tile: one tile in two maps counts twice. A purge reports purged, a seed seeded.",
        "required": [
          "skipped",
          "failed",
          "durationMs"
        ],
        "properties": {
          "purged": {
            "type": "integer"
          },
          "seeded": {
            "type": "integer"
          },
          "skipped": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "durationMs": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request was malformed, named no targets, or named a map, layer, tier, tile or tile matrix set that does not exist. Nothing was touched.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CacheResult"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "A token is configured and the request did not present it. Nothing was touched.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CacheResult"
            }
          }
        }
      },
      "Failed": {
        "description": "A tile could not be processed, usually because a cache backend failed. The body holds the counts so far. Repeating a purge is safe.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CacheResult"
            }
          }
        }
      },
      "TooLarge": {
        "description": "The request covers more tiles than max_tiles_per_request, counted across every tile matrix set, zoom and layer. Nothing was touched; narrow it, or use the shigola cache CLI.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CacheResult"
            }
          }
        }
      },
      "Busy": {
        "description": "max_concurrent_requests are already being worked on. Nothing was touched; retry after the Retry-After header's seconds.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            },
            "description": "Seconds to wait before retrying."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CacheResult"
            }
          }
        }
      },
      "TimedOut": {
        "description": "The request ran past request_timeout_ms and its remaining work was cancelled. The body holds the counts so far. Repeating a purge is safe.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CacheResult"
            }
          }
        }
      },
      "SeedUnprocessable": {
        "description": "The request covers more than max_tiles_per_request, or names layers, which seed does not support. Nothing was touched.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CacheResult"
            }
          }
        }
      }
    }
  }
}
